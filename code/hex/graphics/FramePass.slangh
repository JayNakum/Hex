struct FrameConstants
{
    float totalTime;
    float deltaTime;
    uint2 size;
    uint index;
    const uint padding[3];
};

struct PassConstants
{
    float4x4 view;
    float4x4 invView;

    float3 eyePosition;
    const uint _passPadding0;

    float4x4 projection;
    float4x4 invProjection;

    float nearZ;
    float farZ;
    const uint _passPadding1;
    const uint _passPadding2;

    float4x4 viewProjection;
    float4x4 invViewProjection;

    float2 renderTargetSize;
    float2 invRenderTargetSize;

    const uint _passPadding[5];
};
